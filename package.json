{
  "name": "horticultural-therapy-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "护理学院大创园艺疗法展示型微信小程序",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev:h5": "uni",
    "dev:mp-weixin": "uni -p mp-weixin",
    "build:h5": "uni build",
    "build:mp-weixin": "uni build -p mp-weixin",
    "build:mp-weixin:cloud": "uni build -p mp-weixin && node scripts/prepare-cloud-build.mjs",
    "build:mp-weixin:demo": "node scripts/build-demo.mjs",
    "check:mock": "node scripts/check-mock.mjs",
    "check:assessment": "node scripts/check-assessment.mjs",
    "check:experience": "node scripts/check-experience.mjs",
    "check:completeness": "node scripts/check-completeness.mjs",
    "check:demo": "node scripts/check-demo.mjs",
    "check:community": "node scripts/check-community.mjs",
    "check:cloud-repository": "node scripts/check-cloud-repository.mjs",
    "test:e2e:community": "node scripts/e2e-community.mjs",
    "test:e2e:courses": "node scripts/e2e-courses.mjs",
    "local:server": "node scripts/community-server.mjs",
    "local:mini": "node scripts/run-local.mjs mini",
    "local:admin": "node scripts/run-local.mjs admin",
    "build:admin": "vite build --config admin/vite.config.mjs",
    "cloud:seed": "node scripts/cloud-seed.mjs",
    "check": "pnpm run build:mp-weixin"
  },
  "dependencies": {
    "@cloudbase/js-sdk": "^2.32.0",
    "@dcloudio/uni-app": "3.0.0-5020320260806002",
    "@dcloudio/uni-components": "3.0.0-5020320260806002",
    "@dcloudio/uni-h5": "3.0.0-5020320260806002",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020320260806002",
    "pinia": "2.0.36",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020320260806002",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020320260806002",
    "@playwright/test": "1.55.1",
    "@vitejs/plugin-vue": "5.0.5",
    "@vue/runtime-core": "3.4.21",
    "prettier": "3.6.2",
    "sass": "1.102.0",
    "vite": "5.2.8"
  }
}
